			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792983411170</Id>
					<Name><![CDATA[procTime]]></Name>
					<X>430</X><Y>80</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[lot]]></Name>
						<Type><![CDATA[lot]]></Type>
					</Parameter>
					<Body><![CDATA[return selectFrom(routes)
    .where(routes.product.eq(lot.product), routes.step.eq(lot.step))
    .uniqueResult(routes.proc_time_h);]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1792983659150</Id>
					<Name><![CDATA[route]]></Name>
					<X>460</X><Y>290</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[lot]]></Name>
						<Type><![CDATA[lot]]></Type>
					</Parameter>
					<Body><![CDATA[lot.step++;
if (lot.step > lot.numSteps) {
    enterDone.take(lot);
    return;
}
String g = selectFrom(routes)
    .where(routes.product.eq(lot.product), routes.step.eq(lot.step))
    .uniqueResult(routes.tool_group);
switch (g) {
    case "DEPO":  enterDepo.take(lot);  break;
    case "LITHO": enterLitho.take(lot); break;
    case "ETCH":  enterEtch.take(lot);  break;
    case "IMPL":  enterImpl.take(lot);  break;
    case "CMP":   enterCMP.take(lot);   break;
    case "METRO": enterMetro.take(lot); break;
    default: error("Unknown tool group " + g);
}]]></Body>
				</Function>
			</Functions>

